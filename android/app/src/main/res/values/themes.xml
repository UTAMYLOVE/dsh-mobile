<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Framework Material theme without an ActionBar; the Compose screens draw everything themselves. -->
    <style name="Theme.DshMobile" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/ink</item>
        <item name="android:colorAccent">@color/ink</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!--
        Starting windows an older build handed to the system (SplashScreen.setSplashScreenTheme) for its colour themes. The
        theme engine is gone (T08), but the system may still hold one of these for the next cold start after the update: they
        stay so that start resolves to a known style.
    -->
    <style name="Theme.DshMobile.Start.Night" parent="Theme.DshMobile">
        <item name="android:windowBackground">@color/start_night</item>
        <item name="android:windowSplashScreenBackground">@color/start_night</item>
        <item name="android:statusBarColor">@color/start_night</item>
        <item name="android:navigationBarColor">@color/start_night</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="Theme.DshMobile.Start.Rose" parent="Theme.DshMobile">
        <item name="android:windowBackground">@color/start_rose</item>
        <item name="android:windowSplashScreenBackground">@color/start_rose</item>
        <item name="android:statusBarColor">@color/start_rose</item>
        <item name="android:navigationBarColor">@color/start_rose</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="Theme.DshMobile.Start.Archive" parent="Theme.DshMobile">
        <item name="android:windowBackground">@color/start_archive</item>
        <item name="android:windowSplashScreenBackground">@color/start_archive</item>
        <item name="android:statusBarColor">@color/start_archive</item>
        <item name="android:navigationBarColor">@color/start_archive</item>
    </style>
    <style name="Theme.DshMobile.Start.Mist" parent="Theme.DshMobile">
        <item name="android:windowBackground">@color/start_mist</item>
        <item name="android:windowSplashScreenBackground">@color/start_mist</item>
        <item name="android:statusBarColor">@color/start_mist</item>
        <item name="android:navigationBarColor">@color/start_mist</item>
    </style>
    <style name="Theme.DshMobile.Start.Lilac" parent="Theme.DshMobile">
        <item name="android:windowBackground">@color/start_lilac</item>
        <item name="android:windowSplashScreenBackground">@color/start_lilac</item>
        <item name="android:statusBarColor">@color/start_lilac</item>
        <item name="android:navigationBarColor">@color/start_lilac</item>
    </style>
</resources>

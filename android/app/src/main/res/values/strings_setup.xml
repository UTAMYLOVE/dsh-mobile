    <string name="ob_day_one">開始第一天</string>
    <string name="ob_welcome_title">歡迎來到小雨娛樂</string>
    <string name="ob_welcome_text">我是小葵，你的經紀人。以後吃什麼、練什麼、讀什麼，直接跟我說，我來記、我來算。先花幾分鐘把公司設定好。</string>
    <string name="ob_keys_title">接上小葵的腦袋</string>
    <string name="ob_keys_text">小葵需要金鑰才會思考。兩把有一把就能用，兩把都有最好。每一把要貼在自己那一格，貼錯格會被拒絕。金鑰只存在這支手機的安全區，不會寫進檔案，也不會上傳。</string>
    <string name="ob_key_claude">第一把金鑰（必填）</string>
    <string name="ob_key_deepseek">第二把金鑰（可不填）</string>
    <string name="ob_key_error">存不起來，請再試一次。</string>
    <string name="ob_paste_title">貼上你的要求文件</string>
    <string name="ob_paste_text">把你自己寫的作息、飲食、訓練要求整份貼進來。小葵姐會讀懂，整理成公司規章給你確認。</string>
    <string name="ob_paste_hint">在這裡貼上文件</string>
    <string name="ob_reading_title">小葵姐在讀</string>
    <string name="ob_reading_text">正在整理你的文件，大概要一兩分鐘…</string>
    <string name="ob_confirm_title">我整理成這樣，對嗎？</string>
    <string name="ob_missing">還缺：%1$s</string>
